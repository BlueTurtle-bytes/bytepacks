# Generated by apexpack — replaced by the project's nginx.conf when it has one.
# Port 8080 matches image.ports and is bindable by uid 65532. The SPA fallback
# suits the Angular/React/Vue projects this profile mostly serves and is
# harmless for a plain static site.
server {
    listen      8080;
    server_name _;
    root        /usr/share/nginx/html;
    index       index.html index.htm;

    location / {
        try_files $uri $uri/ /index.html;
    }

    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root /usr/share/nginx/html;
    }
}
